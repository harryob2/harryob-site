server {
    server_name harryob.co www.harryob.co;

    # Main site
    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # FYP Dash app
    location /fyp/ {
        proxy_pass http://127.0.0.1:5002/fyp/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # PPT Narration app
    location /ppt-narration/ {
        proxy_pass http://127.0.0.1:5003/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50M;
    }

    listen [2a01:4f9:c013:58f7::1]:443 ssl ipv6only=on; # managed by Certbot
    listen 77.42.87.174:443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/harryob.co/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/harryob.co/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.harryob.co) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = harryob.co) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name harryob.co www.harryob.co;
    return 404; # managed by Certbot




}